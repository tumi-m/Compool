# Nothing here is required to run the preview. Every variable below turns on a
# capability that the preview deliberately refuses to fake.

# --- the vault (§10) --------------------------------------------------------
# Until a KMS is configured, the connect flow will not accept an API key at all.
# It refuses rather than collecting a secret it has no way to protect.
KMS_PROVIDER=            # aws | gcp | azure
KMS_KEY_ID=              # the master key's id. never the key material.

# --- the gateway (§6.2) -----------------------------------------------------
# Long agent runs exceed a serverless function's ceiling, and a run that dies at
# the ceiling loses its metering tail. Long work belongs to a separate service.
GATEWAY_URL=
GATEWAY_SHARED_SECRET=

# --- preload (the 3am scheduler) --------------------------------------------
# Vercel sets CRON_SECRET itself when you add a cron; set it locally to test the
# endpoint's auth. Without a queue URL the schedule is browser-local.
CRON_SECRET=
TIDEPOOL_QUEUE_URL=
TIDEPOOL_QUEUE_TOKEN=

# --- system of record -------------------------------------------------------
DATABASE_URL=
DATABASE_URL_DIRECT=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Provider API keys are NOT environment variables. They are user data, and they
# live in the vault. The only exception is recording test fixtures.
